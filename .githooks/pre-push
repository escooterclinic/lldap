#!/usr/bin/env bash
# gate-shim: 1
# .githooks/pre-push — THE SHIM. Managed by claude-code-policy. Do not edit this file.
#
# The `gate-shim:` line above is the marker every reader keys on — tools, and the next
# person wondering why this file has no gates in it. It is deliberately the second line and
# deliberately not prose: recognising a shim by a sentence is how a reworded comment turns
# a converted repo back into "CUSTOMISED" and quietly un-converts it.
#
# WHAT THIS REPLACES, AND WHY. Until now `bin/gate-enrol.py` copied the whole 713-line
# `policy/gate-template/pre-push` into each repo, and "the enroller never overwrites one
# that already exists". So every enrolled repo froze a copy at its enrolment date, a
# change to the template reached those repos NEVER, and nothing noticed. Measured
# 2026-09-18: 143 of 151 repos carry a drifted copy. Fixing that repo by repo is 143 PRs
# for every future template change, and `bin/gate_hook_upgrade.py` can only refresh the
# provably-untouched minority (9 of 23 measured) — it refuses the rest by design, because
# overwriting a customised hook deletes working policy to install uniformity.
#
# This file is the choke point. It carries NO gate logic at all: it resolves the gate body
# and execs it. Edit the template once and every repo carrying this shim runs the new gate
# on its next push. The shim itself should essentially never change, which is what makes
# "drifted shim" a non-event rather than the fleet-wide problem the body was.
#
# RESOLUTION ORDER — first readable hit wins, and the order is the whole contract:
#
#   1  $CLAUDE_GATE_TEMPLATE                     explicit override. Tests use it; so does
#                                                anyone bisecting a gate change. Highest
#                                                precedence so a deliberate override is
#                                                never silently outranked.
#   2  $CLAUDE_POLICY_RUNTIME/policy/gate-template/pre-push
#      (default ~/.claude/policy-runtime/...)    THE CHOKE POINT. A self-converging
#                                                checkout of this repo, pulled at session
#                                                start, so one edit here reaches every repo
#                                                on this machine at its next push. Only a
#                                                body carrying the `# gate-body-contract:`
#                                                line is trusted here — measured 2026-10: an
#                                                unmanaged checkout frozen months old won
#                                                this leg for days on CT243. Without the
#                                                line it drops to leg 4.
#   3  .githooks/pre-push.vendored               the in-repo copy. This is the "serve both
#                                                cases" leg: a clone on a machine with no
#                                                policy runtime — CI, a colleague, a fresh
#                                                box, a container — still gates, using
#                                                whatever revision the repo last vendored.
#   4  the runtime body WITHOUT the contract line  last resort, so a clone with no vendored
#                                                copy behaves exactly as before (still gated,
#                                                and the shim names the stale runtime).
#
# 🔴 IT FAILS CLOSED. If nothing readable resolves — a markerless runtime body counts,
# because that is still a gate body — the push is REFUSED, not waved through. A gate that
# silently disappears when its body is missing is worse than no gate: everyone keeps
# believing they are covered. The refusal names every path it tried so the fix is obvious.
#
# 🔴 THIS FILE MUST NOT READ STDIN. Git hands a pre-push hook the ref list on stdin and
# keeps that pipe open until it is consumed; the body drains it with `PUSH_REFS="$(cat)"`.
# If the shim read even one line, the body would get a short list and the ref-based guards
# would silently measure the wrong thing. `exec` hands stdin over untouched — that is why
# this is an exec and not a call.
#
# A REPO'S OWN DEVIATIONS STILL BELONG TO IT. `.githooks/pre-push.local`, if present, is
# sourced by the body before any gate runs (see `_pp_source_local` in the template). That
# is where `PANGOLIN_SKIP_VERIFY`, a custom `_pp_gate`, or a repo's bypass ledger lives now
# — declared, small, and readable, instead of expressed by forking 713 lines. Repos that
# have not been converted keep their existing hook untouched: this rail converts the
# provably-pristine and reports the rest, it never overwrites a local decision.

set -uo pipefail

# HOME IS NOT GUARANTEED. A systemd unit has none, and under `set -u` a bare `$HOME` aborts
# this shim before any leg is tried — github-access-manager's panel pushes the access
# manifest from exactly such a unit (CT243). Resolve it once, from the passwd database when
# the environment has none; empty only leaves the runtime leg unreadable, so the vendored
# leg still answers.
HOME_DIR="${HOME:-}"
if [ -z "$HOME_DIR" ] && command -v getent >/dev/null 2>&1; then
	HOME_DIR="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
fi

_gate_body=""
_gate_tried=()

_pp_try() {
	[ -n "${1:-}" ] || return 1
	_gate_tried+=("$1")
	[ -r "$1" ] || return 1
	_gate_body="$1"
	return 0
}

_pp_runtime="${CLAUDE_POLICY_RUNTIME:-$HOME_DIR/.claude/policy-runtime}/policy/gate-template/pre-push"

# A runtime body is the choke point only while it carries the contract line. A readable
# body without it predates the contract — measured: an unmanaged checkout frozen since
# 2026-08-20 sat at /root/.claude/policy-runtime on CT243 and won the leg for days.
# Pure bash, no external tools: a unit's PATH can be bare, and a missing binary would read
# every current runtime as stale. `$(<file)` reads the FILE, never this hook's stdin.
_pp_has_contract() {
	local _text
	_text="$(<"$1")" || return 1
	[[ $'\n'"$_text" =~ $'\n'"# gate-body-contract: "[1-9] ]]
}

_pp_stale_runtime=""
if [ -r "$_pp_runtime" ] && ! _pp_has_contract "$_pp_runtime"; then
	_pp_stale_runtime="$_pp_runtime"
fi

# `git rev-parse --show-toplevel` rather than a relative path: git runs a hook with the
# working directory set to the top level of the work tree in the ordinary case, but not in
# a worktree or a bare-ish setup, and a relative path would then resolve to nothing and
# take the vendored leg out of service exactly where it is most likely to be the only leg.
_pp_toplevel="$(git rev-parse --show-toplevel 2>/dev/null || true)"

_pp_try "${CLAUDE_GATE_TEMPLATE:-}" ||
	{ [ -z "$_pp_stale_runtime" ] && _pp_try "$_pp_runtime"; } ||
	_pp_try "${_pp_toplevel:-.}/.githooks/pre-push.vendored" ||
	{ [ -n "$_pp_stale_runtime" ] && _pp_try "$_pp_stale_runtime"; } ||
	true

if [ -n "$_pp_stale_runtime" ]; then
	{
		echo "⚠️  GATE SHIM: $_pp_stale_runtime has no '# gate-body-contract:' line — it is a stale policy runtime"
		echo "   that predates the gate-body contract; using $_gate_body instead."
	} >&2
fi

if [ -z "$_gate_body" ]; then
	{
		echo ""
		echo "🔴 GATE SHIM: no gate body found — REFUSING THE PUSH."
		echo ""
		echo "   This repo's .githooks/pre-push is a shim that runs the shared gate body."
		echo "   None of the places it looks was readable:"
		for _p in "${_gate_tried[@]}"; do
			echo "     - $_p"
		done
		echo ""
		echo "   It refuses rather than passing, because a gate that quietly vanishes is"
		echo "   worse than no gate: the push would look certified and nothing would have run."
		echo ""
		echo "   Fix whichever is right for this machine:"
		echo "     - the policy runtime is missing or behind:"
		echo "         git -C \"${CLAUDE_POLICY_RUNTIME:-$HOME_DIR/.claude/policy-runtime}\" pull --ff-only"
		echo "     - this clone has no vendored fallback:"
		echo "         python3 <claude-code-policy>/bin/gate-hook-chokepoint.py --repo . --apply"
		echo "     - you are deliberately running a different body:"
		echo "         CLAUDE_GATE_TEMPLATE=/path/to/pre-push git push ..."
		echo ""
	} >&2
	exit 1
fi

exec bash "$_gate_body" "$@"
